# auto-arr configuration — setup.sh copies this to .env and fills in secrets.
# Blank values are auto-generated on first run.

# Host/system
TZ=Etc/UTC
PUID=1000
PGID=1000

# Storage roots (host paths; relative = relative to this repo)
DATA_ROOT=./data
CONFIG_ROOT=./config

# Host ports
HOMEPAGE_PORT=3000
QBIT_PORT=8080
PROWLARR_PORT=9696
RADARR_PORT=7878
SONARR_PORT=8989
JELLYFIN_PORT=8096
JELLYSEERR_PORT=5055

# How browsers reach this machine (dashboard links, printed URLs). Blank = first
# IP of `hostname -I`; set it when that is not your LAN address (e.g. on WSL).
PUBLIC_HOST=
# host:port values Homepage may be opened at, comma separated. Blank =
# PUBLIC_HOST and localhost; add a hostname or VPN address if you use one.
HOMEPAGE_ALLOWED_HOSTS=

# Login prompts on the LAN for Radarr/Sonarr/Prowlarr/qBittorrent: "skip" lets
# private (LAN) addresses in without a password — anyone who can reach the
# ports gets in, so keep them off the internet — "require" always asks.
LAN_LOGIN=skip

# Quality profile (by name, as listed in Radarr/Sonarr) that Seerr requests
# with. Radarr/Sonarr ship: Any, SD, HD-720p, HD-1080p, Ultra-HD, HD - 720p/1080p.
QUALITY_PROFILE=HD-1080p

# Seeding cleanup: qBittorrent pauses a torrent once EITHER limit is reached and
# Radarr/Sonarr then delete it (and its files) after import. Library files are
# hardlinks, so they are not affected. 0 disables a limit.
SEED_RATIO=1.0
SEED_TIME_MINUTES=1440

# Backups (scripts/backup.sh): where archives go and how many to keep
BACKUP_DIR=./backups
BACKUP_KEEP=7

# API keys (32 hex chars; auto-generated)
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=

# Web UI credentials (passwords auto-generated)
ARR_ADMIN_USER=admin
ARR_ADMIN_PASSWORD=
QBIT_USER=admin
QBIT_PASSWORD=
JELLYFIN_ADMIN_USER=admin
JELLYFIN_ADMIN_PASSWORD=
